# MongoDB Root Administrator Credentials
MONGO_ROOT_USER=admin_user
MONGO_ROOT_PASSWORD=AdminSecure2026!

# Host Connection Settings (Host port 27030 avoids collision with existing MongoDB chapters)
MONGO_HOST=127.0.0.1
MONGO_PORT=27030

# Application Database & User Credentials
APP_DB_NAME=company_db
APP_READ_USER=app_user_read
APP_READ_PASSWORD=ReadPassword2026!
APP_WRITE_USER=app_user_write
APP_WRITE_PASSWORD=WritePassword2026!

# TLS Local File Paths
TLS_CA_FILE=certs/ca.crt
TLS_CLIENT_PEM=certs/client.pem
TLS_SERVER_PEM=certs/server.pem
